---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import WaveSeparator from '../components/WaveSeparator.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { getSiteData } from '../utils/sanity';

const { settings, projects } = await getSiteData();
const { hero, seo, contact, footer, socialLinks } = settings;
---

<Layout title={seo?.title ?? 'Home'} description={seo?.description}>
  
  <div class="max-w-5xl mx-auto px-6 pt-10">
    <div class="hero-animate-1">
      <Header socialLinks={socialLinks} />
    </div>
  
    <Hero 
      title={hero?.title!}
      subtitle={hero?.subtitle!}
      ctaLabel={hero?.ctaLabel!}
    />
  </div> 

  <WaveSeparator position="top" />

  <ProjectsSection projects={projects} />

  <WaveSeparator position="bottom" />

  <div class="max-w-5xl mx-auto px-6 pt-4 pb-10">
    <ContactSection contact={contact as any} />
    <Footer footer={footer as any} />
  </div>

</Layout>
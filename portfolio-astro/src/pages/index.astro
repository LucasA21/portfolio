---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Home">
  <Header />
  
  <section class="flex flex-col md:flex-row items-start justify-between gap-10 mt-24">
    <div class="flex-1 text-center">
      <p class="text-[32px] leading-[130%] tracking-wider font-normal mb-6 flex items-center justify-center gap-3">
        <span><span class="font-semibold text-accent-brown">Hi!</span> I am Lucas</span>
        <img src="/Imagen-pegada.svg" alt="Dibujito decorativo" class="inline-block h-8" />
      </p>
      
      <h1 class="text-[48px] leading-[130%] tracking-wider font-normal">
        Creative and efficient<br />
        <span class="font-semibold text-accent-brown">Frontend Developer</span> you<br />
        can trust
      </h1>
    </div>

    <div class="shrink-0 flex justify-center md:justify-end">
      <img src="/hero-illustration.svg" alt="Ilustración de Lucas trabajando en su computadora" class="w-72" />
    </div>
  </section>

  <div class="flex justify-center mt-20 mb-32">
    <a href="#projects" class="btn-projects inline-flex bg-glass-card border border-stroke px-8 py-2.5 rounded-full text-sm font-medium hover:shadow-md transition-all items-center gap-2 cursor-pointer group">
      Projects
      <svg class="btn-projects-arrow w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </a>
  </div>

  <section id="projects" class="scroll-mt-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <ProjectCard 
        title="Eco Flow" 
        description="A minimalist guide to a mindful life. Developed with Astro and Tailwind CSS focusing on performance and accessibility."
        tags={["Astro", "Tailwind", "UX Design"]}
      />
      <ProjectCard 
        title="Serene Space" 
        description="Dashboard interface for a meditation app. Features complex state management and smooth micro-interactions."
        tags={["React", "Framer Motion"]}
      />
      <ProjectCard 
        title="Quiet Commerce" 
        description="An e-commerce platform designed to reduce cognitive load, increasing conversion rates without screaming for attention."
        tags={["Next.js", "Stripe"]}
      />
    </div>
  </section>

  <ContactSection />

  <Footer />
</Layout>
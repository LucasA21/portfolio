---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  subtitle: string;
  ctaLabel: string;
}

const { title, subtitle, ctaLabel } = Astro.props;

// Cargar SVGs para inlinear (Mejora LCP)
const heroSvg = fs.readFileSync(path.resolve('./public/hero-illustration.svg'), 'utf-8')
  .replace(/width=".*?"/, 'width="100%"')
  .replace(/height=".*?"/, 'height="100%"')
  .replace(/^[\s\S]*?(?=<svg)/i, ""); // Eliminar XML prolog y DOCTYPE
---

<section id="about" class="flex flex-col md:flex-row items-center md:items-center justify-between gap-8 lg:gap-16 mt-6 md:mt-12 pb-12 md:pb-0 scroll-mt-[22vh]">
  
  <div class="flex-1 w-full text-center md:text-left px-2 sm:px-6 md:pl-0 lg:pl-8 hero-animate-2 flex flex-col items-center md:items-start justify-center">
    
    <!-- Saludo solo Mobile -->
    <p class="md:hidden text-xl font-medium tracking-wider opacity-85 mb-4 text-text-dark">
      ¡Hola! Soy <span class="font-semibold text-accent-brown">Lucas</span>
    </p>

    <h1 class="text-[clamp(2.2rem,7vw,2.75rem)] leading-[120%] md:leading-[130%] tracking-normal md:tracking-wider font-normal max-w-[800px] text-balance">
      <span class="font-semibold text-accent-brown">{title}</span><br />
      {subtitle}
    </h1>

    <!-- Botón Desktop: se mantiene con el texto -->
    <div class="hidden md:flex mt-10 md:mt-14 relative z-10 w-full justify-start">
      <a href="#projects" class="btn-projects inline-flex bg-glass-card border border-stroke px-10 py-4 rounded-full text-base font-medium hover:shadow-lg transition-all items-center gap-3 cursor-pointer group active:scale-95">
        {ctaLabel}
        <svg class="btn-projects-arrow w-5 h-5 group-hover:translate-x-1.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Imagen: En mobile queda entre el texto y el botón móvil -->
  <div class="shrink-0 flex justify-center md:justify-end hero-animate-3 w-full md:w-auto -mt-2 md:mt-0">
    <div class="w-64 md:w-80 lg:w-[420px] svg-container" set:html={heroSvg} />
  </div>

  <!-- Botón Mobile: aparece debajo de la imagen -->
  <div class="md:hidden w-full flex justify-center mt-2 hero-animate-2">
    <div class="relative z-10">
       <a href="#projects" class="btn-projects inline-flex bg-glass-card border border-stroke px-8 py-3.5 rounded-full text-sm font-medium hover:shadow-lg transition-all items-center gap-3 cursor-pointer group active:scale-95">
        {ctaLabel}
        <svg class="btn-projects-arrow w-4 h-4 group-hover:translate-x-1.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
    </div>
  </div>

</section>

<style is:global>
  .svg-container svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

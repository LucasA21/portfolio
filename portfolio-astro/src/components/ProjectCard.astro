---
import { Icon } from "astro-icon/components";
import { toHTML } from '@portabletext/to-html';

interface Props {
  id: string;
  title: string;
  description: string;
  content?: any[];
  tags?: string[];
  link?: string;
  mainImage?: string;
  gallery?: string[];
}

const { 
  id,
  title, 
  description, 
  content,
  tags, 
  link = "#",
  mainImage = "",
  gallery 
} = Astro.props;

const safeContent = content || [];
const safeTags = tags || [];
const safeGallery = gallery || [];

const contentHtml = safeContent.length > 0 ? toHTML(safeContent) : description;
const projectData = JSON.stringify({ title, description, contentHtml, tags: safeTags, link, mainImage, gallery: safeGallery });
---

<div 
  class="project-card fade-up group flex flex-col p-8 bg-main-bg border border-stroke/50 rounded-[32px] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-accent-brown/5 hover:border-accent-brown/20 transition-[transform,border-color,box-shadow] duration-500 ease-out h-[380px] backface-hidden transform-[translate3d(0,0,0)] cursor-pointer"
  data-project={projectData}
>
  <div class="flex flex-col h-full">
    <div class="flex justify-between items-start mb-4">
      <h3 class="text-3xl font-medium tracking-wider text-accent-brown group-hover:opacity-80 transition-opacity duration-300">{title}</h3>
      <div class="mt-1 text-accent-brown/30 group-hover:text-accent-brown group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-500 ease-out">
        <Icon name="lucide:maximize-2" size={24} />
      </div>
    </div>
    
    <p class="text-lg leading-[150%] opacity-80 mb-2 line-clamp-5 font-normal">
      {description}
    </p>

    <div class="mt-auto flex flex-col gap-3">
      {safeTags.length > 0 && (
        <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2 mask-linear-right">
          {safeTags.map((tag) => (
            <span class="whitespace-nowrap text-[12px] px-4 py-2 rounded-full border border-stroke/70 bg-white/20 text-text-dark/80 tracking-wide font-medium">
              {tag}
            </span>
          ))}
        </div>
      )}
      
      <button class="flex items-center gap-2 text-sm font-semibold text-accent-brown tracking-[0.15em] uppercase group/btn">
        Ver detalles
        <div class="w-8 h-px bg-accent-brown/30 group-hover/btn:w-12 transition-all duration-300"></div>
      </button>
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .mask-linear-right {
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

</style>

---
interface ContactData {
  tagline: string;
  description: string;
  email: string;
  ctaLabel: string;
}

interface Props {
  contact: ContactData;
}

const { contact } = Astro.props;
---

<section id="contact" class="fade-up-bottom flex flex-col md:flex-row justify-between bg-glass-card/50 backdrop-blur-sm border border-stroke rounded-[40px] pt-6 md:pt-8 px-6 sm:px-10 pb-0 lg:pt-12 lg:px-16 lg:pb-0 gap-2 md:gap-8 mt-24 relative scroll-mt-[22vh] overflow-hidden">
  
  <div class="flex flex-col flex-1 z-10 w-full items-center md:items-start justify-center self-center pt-8 pb-4 md:py-10 lg:py-12">
    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-4 max-w-lg">
      
      <h2 class="text-accent-brown tracking-widest uppercase text-[12px] font-bold mb-2">{contact.tagline}</h2>
      
      <p class="text-lg opacity-80 leading-relaxed mb-4">
        {contact.description}
      </p>
  
      <a 
        href={`mailto:${contact.email}`}
        class="text-[clamp(1.2rem,6vw,40px)] font-medium tracking-wide text-accent-brown hover:opacity-80 transition-opacity break-all md:break-normal mb-6"
      >
        {contact.email}
      </a>

      <a 
        href={`mailto:${contact.email}`}
        class="mt-2 bg-accent-brown text-white px-10 py-3.5 rounded-full text-sm font-medium tracking-widest active:scale-95 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 inline-block"
      >
        {contact.ctaLabel}
      </a>
    </div>
  </div>

  <div class="shrink-0 w-[90%] sm:w-[60%] md:w-1/2 lg:w-[40%] flex justify-center md:justify-end z-10 self-center md:self-end md:-mr-8 lg:-mr-12 -mt-4 md:mt-0">
    <img 
      src="/contact-señalar.svg" 
      alt="Ilustración de Lucas señalando el correo y un buzón" 
      width="967"
      height="1135"
      class="w-full max-w-[380px]"
    />
  </div>

</section>

---
import fs from 'node:fs';
import path from 'node:path';

interface ContactData {
  tagline: string;
  description: string;
  email: string;
  ctaLabel: string;
}

interface Props {
  contact: ContactData;
}

const { contact } = Astro.props;

// Cargar SVGs para inlinear
// Desktop: contact-señalar.svg
const contactDesktopSvg = fs.readFileSync(path.resolve('./public/contact-señalar.svg'), 'utf-8')
  .replace(/width=".*?"/, 'width="100%"')
  .replace(/height=".*?"/, 'height="100%"')
  .replace(/^[\s\S]*?(?=<svg)/i, "");

// Mobile: contact-apoyado.svg (pintado de marrón #531F1F)
const contactMobileSvg = fs.readFileSync(path.resolve('./public/contact-apoyado.svg'), 'utf-8')
  .replace(/width=".*?"/, 'width="100%"')
  .replace(/height=".*?"/, 'height="100%"')
  .replace(/fill="#000000"/g, 'fill="#531F1F"')
  .replace(/^[\s\S]*?(?=<svg)/i, "");
---

<section id="contact" class="fade-up-bottom flex flex-col md:flex-row justify-between bg-glass-card/50 backdrop-blur-sm border border-stroke rounded-[40px] pt-6 md:pt-8 px-6 sm:px-10 pb-0 lg:pt-12 lg:px-16 lg:pb-0 gap-2 md:gap-8 mt-24 md:mt-8 relative scroll-mt-[22vh] overflow-hidden">
  
  <div class="flex flex-col flex-1 z-10 w-full items-center md:items-start justify-center self-center pt-8 pb-4 md:py-10 lg:py-12">
    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-4 max-w-lg">
      
      <h2 class="text-accent-brown tracking-widest uppercase text-[12px] font-bold mb-2">{contact.tagline}</h2>
      
      <p class="text-lg opacity-80 leading-relaxed mb-4">
        {contact.description}
      </p>
  
      <a 
        href={`mailto:${contact.email}`}
        class="group/contact flex flex-col items-center md:items-start gap-6 hover:opacity-90 transition-all"
      >
        <span class="text-[clamp(1.2rem,6vw,40px)] font-medium tracking-wide text-accent-brown break-all md:break-normal">
          {contact.email}
        </span>

        <span class="bg-accent-brown text-white px-10 py-3.5 rounded-full text-sm font-medium tracking-widest active:scale-95 group-hover/contact:shadow-lg group-hover/contact:-translate-y-1 transition-all duration-300 inline-block">
          {contact.ctaLabel}
        </span>
      </a>
    </div>
  </div>

  <div class="shrink-0 w-[90%] sm:w-[60%] md:w-1/2 lg:w-[40%] flex justify-center md:justify-end z-10 self-center md:self-end md:-mr-8 lg:-mr-12 -mt-4 md:mt-0">
    <!-- Imagen para Desktop -->
    <div class="hidden md:block w-full max-w-[380px] contact-svg-container" set:html={contactDesktopSvg} />
    <!-- Imagen para Mobile -->
    <div class="block md:hidden w-full max-w-[320px] contact-svg-container" set:html={contactMobileSvg} />
  </div>

</section>

<style is:global>
  .contact-svg-container svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

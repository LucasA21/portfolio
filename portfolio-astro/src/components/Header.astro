---
import { Icon } from "astro-icon/components";

interface SocialLink {
  _key: string;
  platform: string;
  url: string;
}

interface Props {
  socialLinks?: SocialLink[];
}

const { socialLinks = [] } = Astro.props;

// Mapeo de plataforma a ícono de astro-icon
const iconMap: Record<string, string> = {
  linkedin: 'simple-icons:linkedin',
  github: 'simple-icons:github',
  instagram: 'simple-icons:instagram',
  gmail: 'simple-icons:gmail',
  twitter: 'simple-icons:x',
};
---

<header
  class="flex justify-between items-center bg-glass-card backdrop-blur-md border border-stroke rounded-full px-10 py-2.5"
>
  <div class="header-name group flex flex-col leading-none tracking-wider text-2xl font-medium text-accent-brown cursor-default">
    <div class="flex">
      {["L", "u", "c", "a", "s"].map((l, i) => (
        <span class="letter inline-block" style={`transition-delay: ${i * 40}ms`}>{l}</span>
      ))}
    </div>
    <div class="flex ml-4 -mt-1.5">
      {["A", "r", "a", "y", "a"].map((l, i) => (
        <span class="letter inline-block" style={`transition-delay: ${(i + 5) * 40}ms`}>{l}</span>
      ))}
    </div>
  </div>

  <nav class="flex gap-6 items-center">
    {socialLinks.map((social) => (
      <a
        href={social.url}
        target={social.url.startsWith('mailto:') ? undefined : '_blank'}
        rel={social.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        class="text-accent-brown hover:-translate-y-1 hover:opacity-70 transition-all"
        aria-label={social.platform}
      >
        <Icon name={iconMap[social.platform] ?? 'lucide:link'} size={20} />
      </a>
    ))}
  </nav>
</header>

<style>
  .letter {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1.15);
  }
  
  .header-name:hover .letter {
    transform: translateY(-5px);
    color: var(--color-accent-brown);
    filter: drop-shadow(0 4px 4px rgba(83, 31, 31, 0.1));
  }
</style>

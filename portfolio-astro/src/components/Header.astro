---
import { Icon } from "astro-icon/components";
---

<header
  class="flex justify-between items-center bg-glass-card backdrop-blur-md border border-stroke rounded-full px-10 py-2.5"
>
  <div class="leading-none tracking-wider text-2xl font-medium text-accent-brown">
    <span class="block">Lucas</span>
    <span class="block ml-4 -mt-1.5">Araya</span>
  </div>

  <nav class="flex gap-6 items-center">
    <a
      href="https://www.linkedin.com/in/lucasaraya"
      target="_blank"
      rel="noopener noreferrer"
      class="text-accent-brown hover:-translate-y-1 hover:opacity-70 transition-all"
      aria-label="LinkedIn"
    >
      <Icon name="simple-icons:linkedin" size={20} />
    </a>
    <a
      href="mailto:lucasaraya19@hotmail.com"
      class="text-accent-brown hover:-translate-y-1 hover:opacity-70 transition-all"
      aria-label="Email"
    >
      <Icon name="simple-icons:gmail" size={20} />
    </a>
    <a 
      href="https://www.instagram.com/_lucasaraya/" 
      target="_blank"
      rel="noopener noreferrer"
      class="text-accent-brown hover:-translate-y-1 hover:opacity-70 transition-all"
      aria-label="Instagram"
    >
      <Icon name="simple-icons:instagram" size={20} />
    </a>
    <a 
      href="https://github.com/LucasA21" 
      target="_blank"
      rel="noopener noreferrer"
      class="text-accent-brown hover:-translate-y-1 hover:opacity-70 transition-all"
      aria-label="GitHub"
    >
      <Icon name="simple-icons:github" size={20} />
    </a>
  </nav>
</header>

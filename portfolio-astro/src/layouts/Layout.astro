---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import font400 from "@fontsource/halant/files/halant-latin-400-normal.woff2?url";
import font500 from "@fontsource/halant/files/halant-latin-500-normal.woff2?url";
import font600 from "@fontsource/halant/files/halant-latin-600-normal.woff2?url";
import font700 from "@fontsource/halant/files/halant-latin-700-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Lucas Araya | Frontend Developer", 
  description = "Frontend Developer apasionado por crear interfaces modernas, minimalistas y de alto rendimiento. Explora mi portfolio para ver mis últimos proyectos y soluciones creativas." 
} = Astro.props;

const optimizedTitle = title.includes("Lucas Araya") ? title : `${title} | Lucas Araya | Frontend Developer & Portfolio`;

const canonicalURL = new URL(Astro.url.pathname, "https://lucasaraya.com.ar");
const socialImageURL = new URL("/og-image.png", "https://lucasaraya.com.ar");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Preload Critical Fonts -->
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font700} as="font" type="font/woff2" crossorigin />
    
    <title>{optimizedTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lucas Araya" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F6F5F1" />
    <meta name="robots" content="index, follow" />
    
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={optimizedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={optimizedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <style is:global>
      /* Critical animations inlined to start immediately */
      @keyframes fade-in {
        from { transform: translateY(10px); }
        to { transform: translateY(0); }
      }
      .hero-animate-1 { animation: fade-in 0.6s ease-out forwards; }
      .hero-animate-2 { animation: fade-in 0.6s ease-out 0.1s forwards; }
      .hero-animate-3 { animation: fade-in 0.6s ease-out 0.2s forwards; }

      @media (max-width: 768px) {
        .hero-animate-1, .hero-animate-2, .hero-animate-3 {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }
    </style>
  </head>
  <body>
    <main class="w-full overflow-hidden">
      <slot />
    </main>
    <script>
      const observerOptions = {
        rootMargin: "0px 0px -25% 0px", 
        threshold: 0.1
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);
      
      const observerBottom = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observerBottom.unobserve(entry.target);
          }
        });
      }, { rootMargin: "0px", threshold: 0.1 });

      function startAnimations() {
        document.querySelectorAll(".fade-up").forEach((el) => observer.observe(el));
        document.querySelectorAll(".fade-up-bottom").forEach((el) => observerBottom.observe(el));
      }

      startAnimations();
      document.addEventListener('astro:after-swap', startAnimations);
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
